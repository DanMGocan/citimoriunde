# Copy via npm run local:env. Real .env is gitignored, mode 0600. No production secrets here.
APP_ENV=development
APP_NAME=Biblioteca Comunității
APP_URL=http://localhost:3000
PREVIEW_PORT=3000
# Native production-build preview binds loopback by default. 0.0.0.0/:: only for an approved interface.
PREVIEW_HOST=127.0.0.1
PREVIEW_PROXY_PORT=8080
# Keep false until actual operator/legal/security/email prerequisites are reviewed.
REGISTRATION_ENABLED=false
AUTH_SECRET=generate-a-random-secret-at-least-32-characters
AUTH_SESSION_DAYS=14
AUTH_RATE_LIMIT=10
ADMIN_BOOTSTRAP_EMAIL=gocandan@gmail.com
ADMIN_STEP_UP_MINUTES=30
DATABASE_URL=postgresql://community:local-password-placeholder@127.0.0.1:5432/community
# Compose database credentials: generated locally; URL must match these.
POSTGRES_DB=community
POSTGRES_USER=community
POSTGRES_PASSWORD=generate-a-random-local-password
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_SHARED_BUFFERS_MB=128
WEB_MEMORY_MB=1024
WORKER_MEMORY_MB=384
DATABASE_MEMORY_MB=768
PROXY_MEMORY_MB=128
# Default CPU caps sum to 2.0; these are limits, not measured capacity.
WEB_CPUS=1
DATABASE_CPUS=0.6
WORKER_CPUS=0.25
PROXY_CPUS=0.15
# Proxy request envelope: at least UPLOAD_MAX_MB+1 for multipart overhead.
PROXY_MAX_BODY_MB=16
DB_POOL_MAX=6
WORKER_DB_POOL_MAX=2
# Dedicated private test database only. Harness refuses names without _test suffix. Never use production URL.
TEST_DATABASE_URL=
DB_STATEMENT_TIMEOUT_MS=10000
TRUSTED_PROXY=false
# DNS/HTTPS only. Set SITE_DOMAIN to your real hostname, TLS_EMAIL to real ACME contact.
SITE_DOMAIN=
TLS_EMAIL=
# Actual legal/operator details. Do not use invented identities or addresses.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=
SUPPORT_EMAIL=
LEGAL_REVIEWED=false
PUBLIC_LAUNCH_REVIEWED=false
# Google login needs an OAuth Web application client, not an API key.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP: authenticated transactional email. TLS is required by default.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Operator attestation only: set true after real authentication, sender and inbox delivery checks.
# smtp:check verifies connection/authentication without sending and cannot establish delivery.
SMTP_VERIFIED=false
SMTP_DNS_TIMEOUT_MS=5000
SMTP_CONNECT_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional bibliographic services. Manual/local search always works.
GOOGLE_BOOKS_ENABLED=false
GOOGLE_BOOKS_API_KEY=
OPEN_LIBRARY_ENABLED=false
BOOK_PROVIDER_DAILY_LIMIT=100
BOOK_METADATA_CACHE_DAYS=30
# AI receives bibliographic text only, never people/private messages.
MISTRAL_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_MS=4000
MISTRAL_DAILY_REQUEST_LIMIT=20
MISTRAL_MONTHLY_BUDGET_CENTS=500
# Upper-bound cents per bounded request based on verified actual model pricing; zero disables paid calls.
MISTRAL_MAX_REQUEST_COST_CENTS=0
# Local persistent photos. S3 is optional; leave disabled without a configured adapter/account.
STORAGE_DRIVER=local
STORAGE_PATH=./storage/images
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MAX_PHOTOS=3
UPLOAD_MAX_MB=10
UPLOAD_MAX_PIXELS=40000000
UPLOAD_MEMBER_QUOTA_MB=200
IMAGE_CONCURRENCY=1
LOAN_DEFAULT_DAYS=28
LOAN_MAX_DAYS=90
LOAN_MAX_ACTIVE=5
RESERVATION_HOURS=72
LOAN_REMINDER_DAYS=3
# Operator/legal review required. Active disputes/loans are never silently destroyed.
RETENTION_DAYS=365
MESSAGE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
BACKUP_RETENTION_DAYS=14
BACKUP_PATH=./backups
# rsync destination such as backup-user@backup-host:/encrypted/community; configure SSH independently.
BACKUP_OFFSITE_DESTINATION=
XP_RULE_VERSION=2026-01
XP_PAIR_COOLDOWN_DAYS=30
XP_READING_MONTHLY_CAP=10
XP_LISTING_MONTHLY_CAP=10
XP_LENDER_RETURN=30
XP_BORROWER_RETURN=15
XP_ON_TIME=5
XP_FINISHED_WORK=5
XP_ACCEPTED_GIFT=20
XP_FIRST_LISTING=3
# Monthly challenges are visibly self-reported; they award no extra transaction XP.
CHALLENGE_READING_TARGET=3
CHALLENGE_GENRES_TARGET=2
REVIEW_BLIND_DAYS=14
FORUM_EDIT_MINUTES=60
MESSAGE_DAILY_CONTACT_LIMIT=5
MESSAGE_MINUTE_LIMIT=10
FORUM_MINUTE_LIMIT=5
WORKER_POLL_MS=2000
WORKER_MAX_ATTEMPTS=5
# Must exceed all configured SMTP phase budgets by >=10 seconds; tune after shutdown tests.
WORKER_STOP_GRACE_SECONDS=60
# off: no scripts/gaps. placeholder: review layouts without external requests.
# Production placeholders remain hidden unless ADS_PLACEHOLDERS_PUBLIC=true.
ADS_MODE=placeholder
ADS_PLACEHOLDERS_PUBLIC=false
ADS_CATALOGUE_ENABLED=true
ADS_INLINE_ENABLED=true
ADS_INLINE_AFTER=8
ADS_SIDEBAR_ENABLED=true
ADS_LOWER_ENABLED=false
# Only real verified publisher/client and slot IDs. Live ads remain blocked until CMP validation.
ADSENSE_CLIENT_ID=
ADSENSE_VERIFIED=false
ADS_CATALOGUE_SLOT_ID=
ADS_INLINE_SLOT_ID=
ADS_SIDEBAR_SLOT_ID=
ADS_LOWER_SLOT_ID=
# Currently Google-certified CMP chosen/configured by operator; script bootstrap is explicit.
CMP_PROVIDER=
# Supported seam only: provider cookiebot, script https://consent.cookiebot.com/uc.js, real domain-group UUID.
CMP_SCRIPT_URL=
CMP_PUBLISHER_ID=
CMP_CSP_ENABLED=false
CMP_CERTIFIED=false
CMP_VALIDATED=false
ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_CONVERSION_ENABLED=false
GOOGLE_ADS_ID=
# Reserved for an operator-approved conversion event. No conversions are fabricated automatically.
GOOGLE_ADS_CONVERSION_LABEL=
# Optional absolute path to a systemd LoadCredential copy; blank uses .env.
CONFIG_ENV_FILE=
