{
	# Separate local admin socket; no public configuration API.
	admin unix//run/citimoriunde-caddy/admin.sock
	persist_config off
	grace_period 10s
	# Access logs are disabled. Runtime logs are discarded because Caddy's
	# unfilterable message field may contain callback/challenge URLs.
	log default {
		output discard
	}
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}
}

citimoriunde.eu {
	encode zstd gzip
	request_body {
		max_size 16MB
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.citimoriunde.eu {
	redir https://citimoriunde.eu{uri} permanent
	header -Server
}
